rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function adminDoc() { return /databases/$(database)/documents/config/admin; }
  function isAdmin() {
   return signedIn() && exists(adminDoc()) && get(adminDoc()).data.uid == request.auth.uid;
  }
  function subActive(uid) {
   let p = /databases/$(database)/documents/subscriptions/$(uid);
   return exists(p)
    && get(p).data.status == 'ACTIVE'
    && get(p).data.expiresAt is timestamp
    && get(p).data.expiresAt > request.time;
  }
  function doctorApproved(uid) {
   return exists(/databases/$(database)/documents/doctors/$(uid))
    && get(/databases/$(database)/documents/doctors/$(uid)).data.approved == true;
  }
  function userType() {
   return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType;
  }
  function qPath(did, d) {
   return /databases/$(database)/documents/queues/$(did + '_' + d);
  }
  function aPath(did, d, pid) {
   return /databases/$(database)/documents/appointments/$(did + '_' + d + '_' + pid);
  }
  function validDate(d) {
   return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
  }
  function docKeys() {
   return ['uid','name','specialty','clinicName','city','address','hours','fee','updatedAt',
       'startHour','endHour','slotMinutes','bio','lat','lng','mapLink','locationUpdatedAt','photo','emergency','hospitalName','hospitalHours','available','availableUpdatedAt','workDays','workLocations','currentWorkLocationId','currentWorkPlaceName','locationStatus'];
  }
  function validWorkPlace(p) {
   return p is map
    && p.keys().hasOnly(['name','startHour','endHour','workDays','slotMinutes','lat','lng','mapLink'])
    && p.name is string && p.name.size() > 0 && p.name.size() <= 120
    && p.startHour is int && p.startHour >= 0 && p.startHour <= 23
    && p.endHour is int && p.endHour >= 1 && p.endHour <= 24
    && p.startHour < p.endHour
    && p.workDays is list && p.workDays.size() > 0 && p.workDays.size() <= 7
    && p.slotMinutes is int && p.slotMinutes >= 10 && p.slotMinutes <= 180
    && (!('lat' in p) || (p.lat is number && p.lat >= -90 && p.lat <= 90))
    && (!('lng' in p) || (p.lng is number && p.lng >= -180 && p.lng <= 180))
    && (!('mapLink' in p) || (p.mapLink is string && p.mapLink.size() <= 2048));
  }
  function workLocationsOk() {
   return !('workLocations' in request.resource.data)
    || (request.resource.data.workLocations is map
     && request.resource.data.workLocations.keys().hasOnly(['clinic','hospital'])
     && 'clinic' in request.resource.data.workLocations
     && validWorkPlace(request.resource.data.workLocations.clinic)
     && (!('hospital' in request.resource.data.workLocations)
       || validWorkPlace(request.resource.data.workLocations.hospital)));
  }
  function photoOk() {
   return !('photo' in request.resource.data)
    || (request.resource.data.photo is string && request.resource.data.photo.size() < 400000);
  }
  function apptKeys() {
   return ['patientId','patientName','patientPhone','doctorId','doctorName','specialty','clinicName',
       'address','city','date','slot','time','number','status','note','createdAt'];
  }
  function anonymized() {
   return request.resource.data.patientName == 'حساب محذوف'
    && request.resource.data.patientPhone == ''
    && request.resource.data.note == '';
  }
  match /config/admin {
   allow read: if isAdmin();
   allow write: if false;
  }
  match /config/contact {
   allow read: if signedIn();
   allow write: if isAdmin()
    && request.resource.data.keys().hasOnly(['name','phone','sham','notes','qr','updatedAt','price1','price3','price6','price12'])
    && request.resource.data.qr is string
    && request.resource.data.qr.size() < 400000;
  }
  match /config/developer {
   allow read: if signedIn();
   allow write: if isAdmin()
    && request.resource.data.keys().hasOnly(['name','photo','updatedAt'])
    && (!('photo' in request.resource.data)
      || (request.resource.data.photo is string && request.resource.data.photo.size() < 400000));
  }
  match /users/{uid} {
   allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
   allow create: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['name','phone','email','accountType','createdAt','emailVerified'])
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.emailVerified == false
    && request.resource.data.accountType in ['patient','doctor','clinic']
    && request.resource.data.name is string && request.resource.data.name.size() <= 100
    && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
   allow update: if signedIn() && request.auth.uid == uid
    && (
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone'])
       && request.auth.token.phone_number == request.resource.data.phone)
     || (request.auth.token.email_verified == true
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified'])
       && request.resource.data.emailVerified == true)
    );
   allow delete: if signedIn() && request.auth.uid == uid && !isAdmin();
  }
  match /doctors/{id} {
   allow read: if signedIn()
    && (
     resource.data.approved == true
     || request.auth.uid == id
     || isAdmin()
    );
   allow create: if signedIn() && request.auth.uid == id
    && userType() in ['doctor','clinic']
    && request.resource.data.keys().hasOnly(docKeys())
    && request.resource.data.uid == id
    && photoOk()
    && workLocationsOk();
   allow update: if signedIn() && (
    (request.auth.uid == id && userType() in ['doctor','clinic']
     && resource.data.uid == id
     && request.resource.data.uid == id
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(docKeys().concat(['phone','emergencyPhone']))
     && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['available','availableUpdatedAt'])
       || (doctorApproved(id) && subActive(id)))
     && !('phone' in request.resource.data)
     && !('emergencyPhone' in request.resource.data)
     && photoOk()
     && workLocationsOk())
    || (isAdmin()
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','approvedBy','approvedAt'])));
   allow delete: if isAdmin() || (signedIn() && request.auth.uid == id);
  }
  match /doctorPrivate/{id} {
   allow read: if signedIn() && (
    request.auth.uid == id
    || isAdmin()
    || (userType() == 'patient' && doctorApproved(id))
   );
   allow create, update: if signedIn()
    && request.auth.uid == id
    && userType() in ['doctor','clinic']
    && request.resource.data.keys().hasOnly(['phone','emergencyPhone','updatedAt'])
    && request.resource.data.phone is string
    && request.resource.data.phone.size() <= 30
    && request.resource.data.emergencyPhone is string
    && request.resource.data.emergencyPhone.size() <= 30;
   allow delete: if isAdmin() || (signedIn() && request.auth.uid == id);
  }
  match /subscriptions/{id} {
   allow read: if signedIn() && (request.auth.uid == id || isAdmin());
   allow create: if isAdmin() || (
    signedIn() && request.auth.uid == id
    && userType() in ['doctor','clinic']
    && request.resource.data.keys().hasOnly(['uid','status','trial','paymentMethod','startedAt','expiresAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.status == 'ACTIVE'
    && request.resource.data.trial == true
    && request.resource.data.paymentMethod == 'Trial'
    && request.resource.data.startedAt == request.time
    && request.resource.data.expiresAt > request.time
    && request.resource.data.expiresAt <= request.time + duration.value(31, 'd'));
   allow update: if isAdmin();
   // يمكن لصاحب الحساب حذف اشتراكه عند حذف الحساب فقط؛ هذا يسحب الاستحقاق ولا يمنح صلاحيات.
   allow delete: if isAdmin() || (signedIn() && request.auth.uid == id);
  }
  match /subscriptionHistory/{id} {
   allow read, create: if isAdmin();
   allow update, delete: if false;
  }
  match /renewalRequests/{id} {
   allow create: if signedIn()
    && request.auth.uid == request.resource.data.uid
    && userType() in ['doctor','clinic']
    && request.resource.data.keys().hasOnly([
     'uid','doctorName','months','planLabel','amount','status','createdAt'
    ])
    && request.resource.data.doctorName is string
    && request.resource.data.doctorName.size() <= 120
    && request.resource.data.months in [1,3,6,12]
    && request.resource.data.planLabel is string
    && request.resource.data.amount is string
    && request.resource.data.amount.size() <= 80
    && request.resource.data.status == 'PENDING'
    && request.resource.data.createdAt == request.time;
   allow read: if signedIn()
    && (resource.data.uid == request.auth.uid || isAdmin());
   allow update: if isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
    && request.resource.data.status in ['PENDING','APPROVED','REJECTED']
    && request.resource.data.reviewedBy == request.auth.uid;
   allow delete: if false;
  }
  match /appointments/{id} {
   allow read: if signedIn()
    && (
     (resource == null
      && id.matches('[A-Za-z0-9]+_[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid))
     || (resource != null
      && (resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid))
    );
   allow create: if signedIn()
    && userType() == 'patient'
    && request.resource.data.keys().hasOnly(apptKeys())
    && request.resource.data.patientId == request.auth.uid
    && request.resource.data.status == 'PENDING'
    && request.resource.data.doctorId is string
    && validDate(request.resource.data.date)
    && request.resource.data.number is int
    && request.resource.data.note is string
    && request.resource.data.note.size() <= 300
    && id == request.resource.data.doctorId + '_' + request.resource.data.date + '_' + request.auth.uid
    && subActive(request.resource.data.doctorId)
    && doctorApproved(request.resource.data.doctorId)
    && getAfter(qPath(request.resource.data.doctorId, request.resource.data.date)).data.last == request.resource.data.number
    && ((!exists(qPath(request.resource.data.doctorId, request.resource.data.date))
       && request.resource.data.number == 1)
      || (exists(qPath(request.resource.data.doctorId, request.resource.data.date))
       && get(qPath(request.resource.data.doctorId, request.resource.data.date)).data.last + 1 == request.resource.data.number));
   allow update: if signedIn() && (
    (resource.data.patientId == request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && resource.data.status in ['PENDING','CONFIRMED']
     && request.resource.data.status == 'CANCELLED')
    || (resource.data.patientId == request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','patientName','patientPhone','note'])
     && resource.data.status in ['PENDING','CONFIRMED']
     && request.resource.data.status == 'CANCELLED'
     && anonymized())
    || (resource.data.patientId == request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientName','patientPhone','note'])
     && anonymized())
    || (resource.data.doctorId == request.auth.uid
     && userType() in ['doctor','clinic']
     && doctorApproved(request.auth.uid)
     && subActive(request.auth.uid)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && resource.data.status == 'PENDING'
     && request.resource.data.status in ['CONFIRMED','CANCELLED'])
    || (resource.data.doctorId == request.auth.uid
     && userType() in ['doctor','clinic']
     && doctorApproved(request.auth.uid)
     && subActive(request.auth.uid)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && resource.data.status == 'CONFIRMED'
     && request.resource.data.status in ['DONE','CANCELLED'])
    || (resource.data.patientId == request.auth.uid
     && userType() == 'patient'
     && resource.data.status == 'CANCELLED'
     && request.resource.data.keys().hasOnly(apptKeys())
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'patientName','patientPhone','doctorName','specialty','clinicName',
      'address','city','slot','time','number','status','note','createdAt'
     ])
     && request.resource.data.status == 'PENDING'
     && request.resource.data.patientId == request.auth.uid
     && request.resource.data.doctorId == resource.data.doctorId
     && request.resource.data.date == resource.data.date
     && request.resource.data.number is int
     && request.resource.data.createdAt == request.time
     && exists(qPath(resource.data.doctorId, resource.data.date))
     && get(qPath(resource.data.doctorId, resource.data.date)).data.last + 1 == request.resource.data.number
     && getAfter(qPath(resource.data.doctorId, resource.data.date)).data.last == request.resource.data.number
     && subActive(resource.data.doctorId)
     && doctorApproved(resource.data.doctorId)));
   allow delete: if false;
  }
  match /queues/{id} {
   allow read: if signedIn();
   allow create: if signedIn()
    && userType() == 'patient'
    && request.resource.data.keys().hasOnly(['doctorId','date','last','current'])
    && request.resource.data.doctorId is string
    && validDate(request.resource.data.date)
    && id == request.resource.data.doctorId + '_' + request.resource.data.date
    && request.resource.data.last == 1
    && request.resource.data.current == 0
    && subActive(request.resource.data.doctorId)
    && doctorApproved(request.resource.data.doctorId)
    && !exists(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid))
    && existsAfter(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid))
    && getAfter(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid)).data.number == 1
    && getAfter(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid)).data.patientId == request.auth.uid
    && getAfter(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid)).data.status == 'PENDING';
   allow update: if signedIn() && (
    (request.auth.uid == resource.data.doctorId
     && userType() in ['doctor','clinic']
     && doctorApproved(request.auth.uid)
     && subActive(request.auth.uid)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current'])
     && request.resource.data.current == resource.data.current + 1
     && request.resource.data.current <= resource.data.last)
    || (userType() == 'patient'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
     && request.resource.data.last == resource.data.last + 1
     && subActive(resource.data.doctorId)
     && doctorApproved(resource.data.doctorId)
     && existsAfter(aPath(resource.data.doctorId, resource.data.date, request.auth.uid))
     && getAfter(aPath(resource.data.doctorId, resource.data.date, request.auth.uid)).data.number == request.resource.data.last
     && getAfter(aPath(resource.data.doctorId, resource.data.date, request.auth.uid)).data.status == 'PENDING'
     && (!exists(aPath(resource.data.doctorId, resource.data.date, request.auth.uid))
       || get(aPath(resource.data.doctorId, resource.data.date, request.auth.uid)).data.status == 'CANCELLED')));
   allow delete: if false;
  }
  match /prescriptions/{id} {
   allow read: if signedIn() && (
    resource.data.patientId == request.auth.uid
    || resource.data.doctorId == request.auth.uid
   );
   allow create: if signedIn()
    && userType() in ['doctor','clinic']
    && doctorApproved(request.auth.uid)
    && subActive(request.auth.uid)
    && request.resource.data.keys().hasOnly(['doctorId','doctorName','patientId','patientName','appointmentId','kind','text','createdAt'])
    && request.resource.data.doctorId == request.auth.uid
    && request.resource.data.kind in ['rx','lab']
    && request.resource.data.text is string
    && request.resource.data.text.size() > 0
    && request.resource.data.text.size() <= 2000
    && request.resource.data.appointmentId is string
    && exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
    && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.doctorId == request.auth.uid
    && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.patientId == request.resource.data.patientId
    && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status in ['CONFIRMED','DONE']
    && request.resource.data.doctorName is string
    && request.resource.data.doctorName.size() <= 120
    && request.resource.data.patientName is string
    && request.resource.data.patientName.size() <= 120
    && request.resource.data.createdAt == request.time;
   // يسمح للطبيب المعتمد بإلغاء مستنده فقط مع إبقاء السجل الطبي وعدم حذف محتواه.
   allow update: if signedIn() && (
    (userType() in ['doctor','clinic']
     && resource.data.doctorId == request.auth.uid
     && doctorApproved(request.auth.uid)
     && !('voidedAt' in resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','voidedAt','voidedBy'])
     && request.resource.data.status == 'VOIDED'
     && request.resource.data.voidedAt == request.time
     && request.resource.data.voidedBy == request.auth.uid)
    || (resource.data.patientId == request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientId','patientName','appointmentId'])
     && !('patientId' in request.resource.data)
     && !('appointmentId' in request.resource.data)
     && request.resource.data.patientName == 'حساب محذوف')
   );
   // الوصفات والسجلات الطبية لا تُحذف مطلقاً؛ يحتفظ الطبيب بالمحتوى بعد إخفاء هوية المريض.
   allow delete: if false;
  }
  match /conversations/{id} {
   allow read: if signedIn() && (
    (resource == null && userType() == 'patient'
     && id.matches('[A-Za-z0-9_-]+_' + request.auth.uid))
    || (resource != null && (resource.data.patientId == request.auth.uid
     || resource.data.doctorId == request.auth.uid))
   );
   allow create: if signedIn()
    && userType() == 'patient'
    && request.resource.data.patientId == request.auth.uid
    && request.resource.data.keys().hasOnly(['doctorId','patientId','doctorName','patientName','appointmentId','lastMessage','lastSenderId','lastAt','createdAt'])
    && (!('lastSenderId' in request.resource.data) || request.resource.data.lastSenderId == request.auth.uid)
    && request.resource.data.doctorId is string
    && request.resource.data.appointmentId is string
    && id == request.resource.data.doctorId + '_' + request.resource.data.patientId
    && exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
    && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.patientId == request.auth.uid
    && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.doctorId == request.resource.data.doctorId
    && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status in ['PENDING','CONFIRMED','DONE']
    && doctorApproved(request.resource.data.doctorId)
    && request.resource.data.createdAt == request.time
    && request.resource.data.lastAt == request.time;
   allow update: if signedIn()
    && (
     (resource.data.patientId == request.auth.uid && userType() == 'patient')
     || (resource.data.doctorId == request.auth.uid
      && userType() in ['doctor','clinic']
      && doctorApproved(request.auth.uid)
      && subActive(request.auth.uid))
    )
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastAt','lastSenderId'])
    && request.resource.data.lastSenderId == request.auth.uid
    && request.resource.data.lastMessage is string
    && request.resource.data.lastMessage.size() <= 1000
    && request.resource.data.lastAt == request.time;
   allow delete: if false;
  }
  match /messages/{id} {
   allow read: if signedIn()
    && exists(/databases/$(database)/documents/conversations/$(resource.data.convId))
    && (
     get(/databases/$(database)/documents/conversations/$(resource.data.convId)).data.patientId == request.auth.uid
     || get(/databases/$(database)/documents/conversations/$(resource.data.convId)).data.doctorId == request.auth.uid
    );
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['convId','senderId','text','createdAt'])
    && request.resource.data.senderId == request.auth.uid
    && request.resource.data.text is string
    && request.resource.data.text.size() > 0
    && request.resource.data.text.size() <= 1000
    && request.resource.data.createdAt == request.time
    && exists(/databases/$(database)/documents/conversations/$(request.resource.data.convId))
    && (
     (get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.patientId == request.auth.uid
      && userType() == 'patient')
     || (get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.doctorId == request.auth.uid
      && userType() in ['doctor','clinic']
      && doctorApproved(request.auth.uid)
      && subActive(request.auth.uid))
    );
   allow update, delete: if false;
  }
  // رموز FCM خاصة بكل جهاز؛ لا يستطيع المستخدم قراءة أو تعديل رموز الآخرين.
  match /fcmTokens/{id} {
   allow read: if signedIn() && resource.data.uid == request.auth.uid;
   allow create, update: if signedIn()
    && request.resource.data.keys().hasOnly(['uid','token','updatedAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.token is string
    && request.resource.data.token.size() > 0
    && request.resource.data.token.size() <= 4096
    && request.resource.data.updatedAt == request.time;
   allow delete: if signedIn() && resource.data.uid == request.auth.uid;
  }
  // مفضلات المريض: كل مستخدم يدير قائمته فقط، ولا يحفظ إلا طبيباً معتمداً.
  match /favorites/{uid}/doctors/{doctorId} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn()
    && request.auth.uid == uid
    && userType() == 'patient'
    && request.resource.data.keys().hasOnly(['doctorId','savedAt'])
    && request.resource.data.doctorId == doctorId
    && request.resource.data.savedAt == request.time
    && doctorApproved(doctorId);
   allow update: if false;
   allow delete: if signedIn() && request.auth.uid == uid;
  }
  // جدول الأدوية: المريض يدير بياناته فقط، مع الاحتفاظ بالسجل وعدم حذف العناصر.
  match /medicationReminders/{uid}/items/{itemId} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn()
    && request.auth.uid == uid
    && userType() == 'patient'
    && request.resource.data.keys().hasOnly(['medicine','dose','time','active','createdAt','updatedAt'])
    && request.resource.data.medicine is string
    && request.resource.data.medicine.size() > 0
    && request.resource.data.medicine.size() <= 100
    && request.resource.data.dose is string
    && request.resource.data.dose.size() > 0
    && request.resource.data.dose.size() <= 80
    && request.resource.data.time is string
    && request.resource.data.time.size() > 0
    && request.resource.data.time.size() <= 40
    && request.resource.data.active == true
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;
   allow update: if signedIn()
    && request.auth.uid == uid
    && userType() == 'patient'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt'])
    && request.resource.data.active is bool
    && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /slots/{id} {
   allow read, create, update: if false;
   allow delete: if signedIn() && (
    resource.data.patientId == request.auth.uid
    || resource.data.doctorId == request.auth.uid
    || isAdmin()
   );
  }
 }
}
