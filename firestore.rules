rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc() { return /databases/$(database)/documents/config/admin; }
    function isAdmin() {
      return signedIn() && exists(adminDoc()) && get(adminDoc()).data.uid == request.auth.uid;
    }
    function subActive(uid) {
      let s = get(/databases/$(database)/documents/subscriptions/$(uid)).data;
      return s.status == 'ACTIVE' && s.expiresAt > request.time;
    }
    function userType() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType;
    }
    function qPath(did, d) {
      return /databases/$(database)/documents/queues/$(did + '_' + d);
    }
    function aPath(did, d, pid) {
      return /databases/$(database)/documents/appointments/$(did + '_' + d + '_' + pid);
    }
    function validDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function docKeys() {
      return ['uid','name','specialty','clinicName','city','address','phone','hours','fee','updatedAt',
              'startHour','endHour','slotMinutes','bio','lat','lng','mapLink','locationUpdatedAt','photo','emergency','emergencyPhone','hospitalName','hospitalHours','available','availableUpdatedAt','workDays'];
    }
    function photoOk() {
      return !('photo' in request.resource.data)
        || (request.resource.data.photo is string && request.resource.data.photo.size() < 400000);
    }
    function apptKeys() {
      return ['patientId','patientName','patientPhone','doctorId','doctorName','specialty','clinicName',
              'address','city','date','slot','time','number','status','note','createdAt'];
    }
    function anonymized() {
      return request.resource.data.patientName == 'حساب محذوف'
        && request.resource.data.patientPhone == ''
        && request.resource.data.note == '';
    }

    match /config/admin {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /config/contact {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','phone','sham','notes','qr','updatedAt','price1','price3','price6','price12'])
        && request.resource.data.qr is string
        && request.resource.data.qr.size() < 400000;
    }

    match /config/developer {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','photo','updatedAt'])
        && (!('photo' in request.resource.data)
            || (request.resource.data.photo is string && request.resource.data.photo.size() < 400000));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','email','accountType','createdAt'])
        && request.resource.data.accountType in ['patient','doctor','clinic']
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /doctors/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == id
        && userType() in ['doctor','clinic']
        && request.resource.data.keys().hasOnly(docKeys())
        && photoOk();
      allow update: if signedIn() && (
        (request.auth.uid == id && userType() in ['doctor','clinic']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(docKeys())
          && photoOk())
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','approvedBy','approvedAt'])));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == id);
    }

    match /subscriptions/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isAdmin());
      // شهر تجريبي مرة واحدة فقط للطبيب أو العيادة لحسابه هو
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == id
        && userType() in ['doctor','clinic']
        && request.resource.data.keys().hasOnly(['uid','status','trial','paymentMethod','startedAt','expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.trial == true
        && request.resource.data.paymentMethod == 'Trial'
        && request.resource.data.startedAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd'));
      allow update, delete: if isAdmin();
    }

    match /subscriptionHistory/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /appointments/{id} {
      allow read: if signedIn() && (resource == null
        || resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(apptKeys())
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.doctorId is string
        && validDate(request.resource.data.date)
        && request.resource.data.number is int
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && id == request.resource.data.doctorId + '_' + request.resource.data.date + '_' + request.auth.uid
        && subActive(request.resource.data.doctorId)
        && getAfter(qPath(request.resource.data.doctorId, request.resource.data.date)).data.last == request.resource.data.number
        && ((!exists(qPath(request.resource.data.doctorId, request.resource.data.date))
              && request.resource.data.number == 1)
            || (exists(qPath(request.resource.data.doctorId, request.resource.data.date))
              && get(qPath(request.resource.data.doctorId, request.resource.data.date)).data.last + 1 == request.resource.data.number));

      allow update: if signedIn() && (
        (resource.data.patientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status in ['PENDING','CONFIRMED']
          && request.resource.data.status == 'CANCELLED')
        || (resource.data.patientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','patientName','patientPhone','note'])
          && resource.data.status in ['PENDING','CONFIRMED']
          && request.resource.data.status == 'CANCELLED'
          && anonymized())
        || (resource.data.patientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientName','patientPhone','note'])
          && anonymized())
        || (resource.data.doctorId == request.auth.uid && subActive(request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'PENDING'
          && request.resource.data.status in ['CONFIRMED','CANCELLED'])
        || (resource.data.doctorId == request.auth.uid && subActive(request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'CONFIRMED'
          && request.resource.data.status in ['DONE','CANCELLED'])
        || (resource.data.patientId == request.auth.uid
          && resource.data.status == 'CANCELLED'
          && request.resource.data.keys().hasOnly(apptKeys())
          && request.resource.data.status == 'PENDING'
          && request.resource.data.patientId == request.auth.uid
          && request.resource.data.doctorId == resource.data.doctorId
          && request.resource.data.date == resource.data.date
          && request.resource.data.number is int
          && exists(qPath(resource.data.doctorId, resource.data.date))
          && get(qPath(resource.data.doctorId, resource.data.date)).data.last + 1 == request.resource.data.number
          && getAfter(qPath(resource.data.doctorId, resource.data.date)).data.last == request.resource.data.number
          && subActive(resource.data.doctorId)));

      allow delete: if false;
    }

    match /queues/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['doctorId','date','last','current'])
        && request.resource.data.doctorId is string
        && validDate(request.resource.data.date)
        && id == request.resource.data.doctorId + '_' + request.resource.data.date
        && request.resource.data.last == 1
        && request.resource.data.current == 0
        && subActive(request.resource.data.doctorId)
        && !exists(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid))
        && existsAfter(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid))
        && getAfter(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid)).data.number == 1
        && getAfter(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid)).data.patientId == request.auth.uid
        && getAfter(aPath(request.resource.data.doctorId, request.resource.data.date, request.auth.uid)).data.status == 'PENDING';

      allow update: if signedIn() && (
        (request.auth.uid == resource.data.doctorId && subActive(request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current'])
          && request.resource.data.current == resource.data.current + 1
          && request.resource.data.current <= resource.data.last)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
          && request.resource.data.last == resource.data.last + 1
          && subActive(resource.data.doctorId)
          && existsAfter(aPath(resource.data.doctorId, resource.data.date, request.auth.uid))
          && getAfter(aPath(resource.data.doctorId, resource.data.date, request.auth.uid)).data.number == request.resource.data.last
          && getAfter(aPath(resource.data.doctorId, resource.data.date, request.auth.uid)).data.status == 'PENDING'
          && (!exists(aPath(resource.data.doctorId, resource.data.date, request.auth.uid))
              || get(aPath(resource.data.doctorId, resource.data.date, request.auth.uid)).data.status == 'CANCELLED')));

      allow delete: if false;
    }

    match /prescriptions/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid);

      allow create: if signedIn()
        && userType() in ['doctor','clinic']
        && subActive(request.auth.uid)
        && request.resource.data.keys().hasOnly(['doctorId','doctorName','patientId','patientName','appointmentId','kind','text','createdAt'])
        && request.resource.data.doctorId == request.auth.uid
        && request.resource.data.kind in ['rx','lab']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.appointmentId is string
        && exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.doctorId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.patientId == request.resource.data.patientId;

      allow update: if false;
      // يحذفها الطبيب أو المريض (المريض يحتاجها عند حذف حسابه)
      allow delete: if signedIn() && (resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid);
    }

    match /conversations/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.keys().hasOnly(['doctorId','patientId','doctorName','patientName','appointmentId','lastMessage','lastAt','createdAt'])
        && request.resource.data.doctorId is string
        && request.resource.data.appointmentId is string
        && id == request.resource.data.doctorId + '_' + request.resource.data.patientId
        && exists(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.patientId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.doctorId == request.resource.data.doctorId;

      allow update: if signedIn()
        && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastAt']);

      allow delete: if false;
    }

    match /messages/{id} {
      allow read: if signedIn() && (
        resource.data.senderId == request.auth.uid
        || get(/databases/$(database)/documents/conversations/$(resource.data.convId)).data.patientId == request.auth.uid
        || get(/databases/$(database)/documents/conversations/$(resource.data.convId)).data.doctorId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['convId','senderId','text','createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.convId))
        && (get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.patientId == request.auth.uid
          || get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.doctorId == request.auth.uid);

      allow update, delete: if false;
    }

    // slots: يستخدمها مسار الحجز القديم في Booking.kt (يحذف الفتحة عند إلغاء الموعد)، فأبقينا القاعدة كما هي
    match /slots/{id} {
      allow read, create, update: if false;
      allow delete: if signedIn();
    }
  }
}
